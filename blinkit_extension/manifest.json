{
  "manifest_version": 3,
  "name": "Blinkit Vendor AI Onboarding",
  "version": "1.0",
  "description": "Extracts catalog data from messy vendor PDFs.",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Blinkit AI",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}